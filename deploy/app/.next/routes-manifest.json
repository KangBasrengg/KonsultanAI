          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/images(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/(icon.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ],
      "regex": "^(?:/(icon.png|favicon.ico))(?:/)?$"
    }
  ],
